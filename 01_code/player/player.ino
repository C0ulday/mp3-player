void displaySettings(uint8_t volume){

  oled.clearDisplay();
  oled.setTextSize(2);
  oled.setTextColor(WHITE);
  oled.setCursor(0,10);
  oled.println("Settings");
  oled.setCursor(0,5);
  oled.println("Volume : %d", &volume);
  oled.display();

}

